{
  "name": "playwright-automation-demo",
  "version": "1.0.0",
  "description": "自动化测试 Demo：Playwright + TypeScript + Page Object Model，包含 UI 功能测试与接口测试",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://demo.playwright.dev/todomvc"
  },
  "keywords": ["playwright", "typescript", "automation", "testing", "e2e"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
